<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="colorAccent">#FF6B35</color>
    <color name="colorPrimary">#E90060</color>
    <color name="colorPrimaryDark">#0B0E23</color>
    <color name="graffiti_background">#0B0E23</color>
    <color name="graffiti_border">#2D3250</color>
    <color name="graffiti_chalk">#E8E4DD</color>
    <color name="graffiti_magenta">#E90060</color>
    <color name="graffiti_orange">#FF6B35</color>
    <color name="graffiti_purple">#8B5CF6</color>
    <color name="graffiti_surface">#121730</color>
    <color name="graffiti_surface_active">#1A2040</color>
    <color name="notification_accent">#E90060</color>
    <color name="notification_background">#0B0E23</color>
    <string name="app_name">Bombest Beats</string>
    <style name="NotificationStyle" parent="android:TextAppearance.Material.Notification">
        <item name="android:textColor">@color/graffiti_chalk</item>
    </style>
    <style name="Theme.BombestBeats" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/colorPrimary</item>
        <item name="android:colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="android:statusBarColor">@color/graffiti_background</item>
        <item name="android:navigationBarColor">@color/graffiti_background</item>
        <item name="android:windowBackground">@color/graffiti_background</item>
    </style>
    <style name="Theme.BombestBeats.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/graffiti_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.BombestBeats</item>
    </style>
</resources>