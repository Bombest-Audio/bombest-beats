<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main App Theme -->
    <style name="Theme.BombestBeats" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/colorPrimary</item>
        <item name="android:colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="android:statusBarColor">@color/graffiti_background</item>
        <item name="android:navigationBarColor">@color/graffiti_background</item>
        <item name="android:windowBackground">@color/graffiti_background</item>
    </style>
    
    <!-- Notification Style -->
    <style name="NotificationStyle" parent="android:TextAppearance.Material.Notification">
        <item name="android:textColor">@color/graffiti_chalk</item>
    </style>
</resources>
